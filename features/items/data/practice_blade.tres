[resource]
script = ExtResource("Script")
id = &"practice_blade"
display_name = "Practice Blade"
description = "Test item sharing the sword moveset and mesh. Upgrades demonstrate independent copies."
category = "melee"
subtype = &"sword"
actions = ExtResource("actions")
equipment = ExtResource("equipment")
visual = ExtResource("visual")
upgrades = ExtResource("upgrade")

