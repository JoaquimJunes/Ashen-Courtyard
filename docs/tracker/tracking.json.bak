    {
      "at": "2026-09-29T22:32:21.597Z",
      "id": "boss-climbing",
      "fields": [
        "status",
        "attention",
        "priority",
        "note",
        "checklist",
        "related",
        "display_name",
        "animation_categories",
        "animation_tags",
        "review_label"
      ],
      "before": null,
      "after": {
        "status": "In progress",
        "attention": [],
        "priority": "Normal",
        "note": "Planned mechanic — planning and technical design are in progress. Gameplay implementation has not started; all acceptance checks remain pending. Full plan: docs/BOSS_CLIMBING_PLAN.md. Implementation target: Ultra AI agent, five development gates, then the laboratory acceptance route and regression/release validation.",
        "checklist": [
          {
            "id": "boss-climbing:attachment",
            "text": "Moving attachments follow translation, rotation and articulation, with at most 2 cm drift over 30 seconds and inherited release velocity applied once.",
            "done": false,
            "source": "docs/BOSS_CLIMBING_PLAN.md"
          },
          {
            "id": "boss-climbing:traversal",
            "text": "Traverse marked curves, animated joints and fully inverted undersides; leap and regrab, with unmarked or blocked routes stopping safely.",
            "done": false,
            "source": "docs/BOSS_CLIMBING_PLAN.md"
          },
          {
            "id": "boss-climbing:collision",
            "text": "Validate carry, rotation, posture, initial overlap and standing against world geometry and other boss limbs without penetration or unsafe capsule expansion.",
            "done": false,
            "source": "docs/BOSS_CLIMBING_PLAN.md"
          },
          {
            "id": "boss-climbing:presentation",
            "text": "Keep planted hands within 3 cm of accepted contacts, preserve shoulder continuity and bone lengths, and sample hitboxes and mouth-based breath from completed poses.",
            "done": false,
            "source": "docs/BOSS_CLIMBING_PLAN.md"
          },
          {
            "id": "boss-climbing:resources-combat",
            "text": "Verify shared stamina, supported recovery, bracing, charged weak-point stabs and single damage application at 30/60/120 Hz, within 0.5 stamina across equivalent runs.",
            "done": false,
            "source": "docs/BOSS_CLIMBING_PLAN.md"
          },
          {
            "id": "boss-climbing:lifecycle",
            "text": "Verify remapped controls, grip toggle, both shoulder cameras, independent render rates, pause, reset, teleport, death, unload, falling, water entry and two independent characters.",
            "done": false,
            "source": "docs/BOSS_CLIMBING_PLAN.md"
          },
          {
            "id": "boss-climbing:hands-on-route",
            "text": "Complete the hands-on route: approach → grab moving leg → cross joint → hang upside down → leap/regrab → rest → brace → charge/stab → release/land.",
            "done": false,
            "source": "docs/BOSS_CLIMBING_PLAN.md"
          },
          {
            "id": "boss-climbing:validation-delivery",
            "text": "Pass focused tests, the full regression runner, clean release/export and smoke checks; record profiling and update movement documentation and the context graph.",
            "done": false,
            "source": "docs/BOSS_CLIMBING_PLAN.md"
          }
        ],
        "related": [],
        "display_name": "",
        "animation_categories": null,
        "animation_tags": null,
        "review_label": ""
      },
      "revision": 108
